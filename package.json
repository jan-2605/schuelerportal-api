{
  "name": "schuelerportal-api",
  "version": "1.0.0",
  "description": "unofficial API for connecting to schülerportal by art soft and more GmbH",
  "homepage": "https://github.com/jan-2605/schuelerportal-api#readme",
  "bugs": { "url": "https://github.com/jan-2605/schuelerportal-api/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/jan-2605/schuelerportal-api.git" },
  "license": "MIT",
  "author": "Jan Grez",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["./package.json", "./dist"],
  "scripts": { "build": "unbuild" },
  "dependencies": {
    "axios": "1.8.3",
    "axios-cookiejar-support": "5.0.5",
    "cheerio": "1.0.0",
    "jsdom": "^26.0.0",
    "tough-cookie": "5.1.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.10",
    "unbuild": "3.5.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
